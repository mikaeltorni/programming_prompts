{
  "name": "positive-codex-cc",
  "description": "positive (skills injected); one coding run each for codex and cc; evalAgent=codex,cc; grok is not a coder and not a judge; all skills; k=5 n=5 (2 terminals)",
  "jobs": [
    {
      "title": "codex x codex,cc",
      "args": [
        "./run_benchmark.sh",
        "harness=codex",
        "evalAgent=codex,cc",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "cc x codex,cc",
      "args": [
        "./run_benchmark.sh",
        "harness=cc",
        "evalAgent=codex,cc",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    }
  ]
}
