{
  "name": "baseline-cc-grok",
  "description": "baseline / no skills (negative control); one coding run each for cc and grok; evalAgent=cc,grok; codex is not a coder and not a judge; all skills; k=5 n=5 (2 terminals)",
  "jobs": [
    {
      "title": "cc x cc,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=cc",
        "evalAgent=cc,grok",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "grok x cc,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=grok",
        "evalAgent=cc,grok",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    }
  ]
}
