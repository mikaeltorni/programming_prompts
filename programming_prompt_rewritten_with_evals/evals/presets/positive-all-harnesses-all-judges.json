{
  "name": "positive-all-harnesses-all-judges",
  "description": "positive (skills injected); one coding run per harness; all three judge that same tree; all skills; k=5 n=5 (3 terminals)",
  "jobs": [
    {
      "title": "codex x codex,cc,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=codex",
        "evalAgent=codex,cc,grok",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "cc x codex,cc,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=cc",
        "evalAgent=codex,cc,grok",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "grok x codex,cc,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=grok",
        "evalAgent=codex,cc,grok",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    }
  ]
}
