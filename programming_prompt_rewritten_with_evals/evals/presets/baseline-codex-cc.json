{
  "name": "baseline-codex-cc",
  "description": "baseline; judges=codex,cc on each coding run; no grok; k=5",
  "jobs": [
    {
      "title": "codex x codex,cc",
      "args": [
        "./run_benchmark.sh",
        "harness=codex",
        "evalAgent=codex,cc",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5"
      ]
    },
    {
      "title": "cc x codex,cc",
      "args": [
        "./run_benchmark.sh",
        "harness=cc",
        "evalAgent=codex,cc",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5"
      ]
    }
  ]
}
