{
  "name": "baseline-codex-cc",
  "description": "baseline / no skills (negative control); codex and cc only; grok is not a coder and not a judge; all skills; k=5 n=5 (4 terminals)",
  "jobs": [
    {
      "title": "codex x codex",
      "args": [
        "./run_benchmark.sh",
        "harness=codex",
        "evalAgent=codex",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "codex x cc",
      "args": [
        "./run_benchmark.sh",
        "harness=codex",
        "evalAgent=cc",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "cc x codex",
      "args": [
        "./run_benchmark.sh",
        "harness=cc",
        "evalAgent=codex",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "cc x cc",
      "args": [
        "./run_benchmark.sh",
        "harness=cc",
        "evalAgent=cc",
        "--baseline",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    }
  ]
}
