        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "grok x cc,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=grok",
        "evalAgent=cc,grok",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    }
  ]
}
