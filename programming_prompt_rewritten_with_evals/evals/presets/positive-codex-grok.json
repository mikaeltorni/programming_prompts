{
  "name": "positive-codex-grok",
  "description": "positive (skills injected); one coding run each for codex and grok; evalAgent=codex,grok; cc is not a coder and not a judge; all skills; k=5 n=5 (2 terminals)",
  "jobs": [
    {
      "title": "codex x codex,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=codex",
        "evalAgent=codex,grok",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    },
    {
      "title": "grok x codex,grok",
      "args": [
        "./run_benchmark.sh",
        "harness=grok",
        "evalAgent=codex,grok",
        "--skills",
        "srp,commenting,logging,worktree",
        "-k",
        "5",
        "-n",
        "5"
      ]
    }
  ]
}
